      "source": [
        "# ===============================\n",
        "# TARGETED PREMIUM HIGH-END CORRECTION\n",
        "# Moves only likely underpriced expensive/premium cars\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "\n",
        "train_url = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/train.csv\"\n",
        "test_url  = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/test.csv\"\n",
        "\n",
        "train = pd.read_csv(train_url)\n",
        "test = pd.read_csv(test_url)\n",
        "\n",
        "base_file = \"Group 5 Test Sub_MARKET_TUNED.csv\"\n",
        "base = pd.read_csv(base_file).rename(columns={\"Actual\": \"base_pred\"})\n",
        "\n",
        "df = test.merge(base, on=\"ID\", how=\"left\")\n",
        "\n",
        "def clean_text(d):\n",
        "    d = d.copy()\n",
        "    for c in [\"brand\", \"model\", \"transmission\", \"fuelType\"]:\n",
        "        d[c] = d[c].astype(str).str.strip().str.lower()\n",
        "    return d\n",
        "\n",
        "train = clean_text(train)\n",
        "df = clean_text(df)\n",
        "\n",
        "train_ref = train[(train[\"price\"] > 500) & (train[\"price\"] < 120000)].copy()\n",
        "\n",
        "premium_models = [\n",
        "    \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "    \"gle class\", \"glc class\", \"v class\",\n",
        "    \"cls class\", \"sl class\", \"touareg\",\n",
        "    \"a6\", \"a7\", \"e class\", \"5 series\", \"7 series\"\n",
        "]\n",
        "\n",
        "df[\"is_premium_target\"] = (\n",
        "    df[\"model\"].isin(premium_models) |\n",
        "    ((df[\"brand\"].isin([\"bmw\", \"audi\", \"mercedes\", \"vw\"])) & (df[\"engineSize\"] >= 2.0))\n",
        ").astype(int)\n",
        "\n",
        "# -------------------------------\n",
        "# Build upper-market anchors\n",
        "# -------------------------------\n",
        "\n",
        "def upper_anchor(group_cols, label):\n",
        "    stats = (\n",
        "        train_ref\n",
        "        .groupby(group_cols, dropna=False)[\"price\"]\n",
        "        .agg(\n",
        "            count=\"count\",\n",
        "            median=\"median\",\n",
        "            q65=lambda x: np.percentile(x, 65),\n",
        "            q70=lambda x: np.percentile(x, 70),\n",
        "            q75=lambda x: np.percentile(x, 75)\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    stats[f\"{label}_count\"] = stats[\"count\"]\n",
        "    stats[f\"{label}_median\"] = stats[\"median\"]\n",
        "    stats[f\"{label}_q70\"] = stats[\"q70\"]\n",
        "\n",
        "    keep = group_cols + [f\"{label}_count\", f\"{label}_median\", f\"{label}_q70\"]\n",
        "    return stats[keep]\n",
        "\n",
        "groups = [\n",
        "    (\"bmy\", [\"brand\", \"model\", \"year\"]),\n",
        "    (\"bmye\", [\"brand\", \"model\", \"year\", \"engineSize\"]),\n",
        "    (\"bmytf\", [\"brand\", \"model\", \"year\", \"transmission\", \"fuelType\"]),\n",
        "]\n",
        "\n",
        "x = df.copy()\n",
        "\n",
        "for label, cols in groups:\n",
        "    x = x.merge(upper_anchor(cols, label), on=cols, how=\"left\")\n",
        "\n",
        "# -------------------------------\n",
        "# Choose strongest credible upper anchor\n",
        "# -------------------------------\n",
        "\n",
        "base_pred = x[\"base_pred\"].values.astype(float)\n",
        "\n",
        "candidate_anchors = []\n",
        "\n",
        "for label in [\"bmye\", \"bmytf\", \"bmy\"]:\n",
        "    anchor = x[f\"{label}_q70\"].values.astype(float)\n",
        "    count = x[f\"{label}_count\"].fillna(0).values.astype(float)\n",
        "\n",
        "    gap_up = (anchor - base_pred) / base_pred\n",
        "\n",
        "    valid = (\n",
        "        ~np.isnan(anchor) &\n",
        "        (count >= 8) &\n",
        "        (gap_up >= 0.02) &\n",
        "        (gap_up <= 0.25)\n",
        "    )\n",
        "\n",
        "    confidence = np.where(valid, np.log1p(count) * gap_up, 0)\n",
        "\n",
        "    candidate_anchors.append((anchor, confidence, valid))\n",
        "\n",
        "best_anchor = base_pred.copy()\n",
        "best_conf = np.zeros(len(x))\n",
        "\n",
        "for anchor, conf, valid in candidate_anchors:\n",
        "    take = conf > best_conf\n",
        "    best_anchor = np.where(take, anchor, best_anchor)\n",
        "    best_conf = np.where(take, conf, best_conf)\n",
        "\n",
        "# -------------------------------\n",
        "# Apply only to premium/high-end rows\n",
        "# -------------------------------\n",
        "\n",
        "base_condition = (\n",
        "    (x[\"is_premium_target\"].values == 1) &\n",
        "    (base_pred >= 25000) &\n",
        "    (best_conf > 0)\n",
        ")\n",
        "\n",
        "print(\"Eligible high-end rows:\", int(base_condition.sum()))\n",
        "\n",
        "versions = {\n",
        "    \"micro\": 0.04,\n",
        "    \"small\": 0.06,\n",
        "    \"medium\": 0.08,\n",
        "    \"strong\": 0.10,\n",
        "}\n",
        "\n",
        "summary = []\n",
        "\n",
        "for name, weight in versions.items():\n",
        "    pred = base_pred.copy()\n",
        "\n",
        "    move = weight * (best_anchor - base_pred)\n",
        "    move = np.clip(move, 0, 0.04 * base_pred)  # upward only, max +4%\n",
        "\n",
        "    pred = np.where(base_condition, base_pred + move, base_pred)\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    out = pd.DataFrame({\n",
        "        \"ID\": x[\"ID\"],\n",
        "        \"Actual\": pred\n",
        "    })\n",
        "\n",
        "    filename = f\"Group 5 PREMIUM_HIGHEND_{name}.csv\"\n",
        "    out.to_csv(filename, index=False)\n",
        "\n",
        "    changed = pred != base_pred\n",
        "\n",
        "    summary.append({\n",
        "        \"file\": filename,\n",
        "        \"changed_rows\": int(changed.sum()),\n",
        "        \"avg_move_changed\": float(np.mean(pred[changed] - base_pred[changed])) if changed.sum() else 0,\n",
        "        \"mean_change_vs_base\": float(pred.mean() - base_pred.mean()),\n",
        "        \"max_move\": float(np.max(pred - base_pred)),\n",
        "        \"missing\": int(np.isnan(pred).sum())\n",
        "    })\n",
        "\n",
        "summary_df = pd.DataFrame(summary)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"PREMIUM HIGH-END SUMMARY\")\n",
        "print(\"==============================\")\n",
        "display(summary_df)\n",
        "\n",
        "print(\"Files created:\")\n",
        "for f in summary_df[\"file\"]:\n",
        "    print(\"-\", f)\n",
        "\n",
        "files.download(\"Group 5 PREMIUM_HIGHEND_small.csv\")"
      ],
