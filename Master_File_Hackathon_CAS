        "# ===============================\n",
        "# DIAGNOSTIC CELL\n",
        "# Find where the model is still making big errors\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "def rmse_np(y, p):\n",
        "    return np.sqrt(mean_squared_error(y, p))\n",
        "\n",
        "# Recreate best anchored validation prediction\n",
        "near_full_cols = [\n",
        "    \"brand\", \"model\", \"year\", \"transmission\",\n",
        "    \"fuelType\", \"tax\", \"mpg\", \"engineSize\"\n",
        "]\n",
        "\n",
        "best_anchored_pred, best_anchor_info = apply_market_anchor(\n",
        "    train_ref=train_part,\n",
        "    target_ref=val_part,\n",
        "    base_pred=best_base_pred,\n",
        "    group_cols=near_full_cols,\n",
        "    max_gap=0.15,\n",
        "    w_2_3=0.20,\n",
        "    w_4_9=0.22,\n",
        "    w_10_plus=0.18\n",
        ")\n",
        "\n",
        "err_df = val_part.copy().reset_index(drop=True)\n",
        "err_df[\"actual\"] = y_val.reset_index(drop=True).values\n",
        "err_df[\"pred\"] = np.array(best_anchored_pred)\n",
        "err_df[\"error\"] = err_df[\"pred\"] - err_df[\"actual\"]\n",
        "err_df[\"abs_error\"] = err_df[\"error\"].abs()\n",
        "err_df[\"pct_error\"] = err_df[\"abs_error\"] / err_df[\"actual\"]\n",
        "err_df[\"price_band\"] = pd.cut(\n",
        "    err_df[\"actual\"],\n",
        "    bins=[0, 5000, 10000, 15000, 20000, 30000, 40000, 60000, 120000],\n",
        "    labels=[\"0-5k\", \"5-10k\", \"10-15k\", \"15-20k\", \"20-30k\", \"30-40k\", \"40-60k\", \"60k+\"]\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"OVERALL\")\n",
        "print(\"==============================\")\n",
        "print(\"RMSE:\", rmse_np(err_df[\"actual\"], err_df[\"pred\"]))\n",
        "print(\"MAE:\", err_df[\"abs_error\"].mean())\n",
        "print(\"Mean error:\", err_df[\"error\"].mean())\n",
        "print(\"Median error:\", err_df[\"error\"].median())\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"RMSE BY PRICE BAND\")\n",
        "print(\"==============================\")\n",
        "price_band_summary = (\n",
        "    err_df\n",
        "    .groupby(\"price_band\")\n",
        "    .apply(lambda x: pd.Series({\n",
        "        \"count\": len(x),\n",
        "        \"rmse\": rmse_np(x[\"actual\"], x[\"pred\"]),\n",
        "        \"mae\": x[\"abs_error\"].mean(),\n",
        "        \"mean_error\": x[\"error\"].mean(),\n",
        "        \"median_actual\": x[\"actual\"].median()\n",
        "    }))\n",
        "    .reset_index()\n",
        "    .sort_values(\"rmse\", ascending=False)\n",
        ")\n",
        "display(price_band_summary)\n",
