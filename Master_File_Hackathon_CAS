      "cell_type": "code",
      "source": [
        "# ===============================\n",
        "# HIGH-CONFIDENCE EXACT/SPEC ANCHOR ONLY\n",
        "# Smaller coverage, more robust\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "\n",
        "train_url = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/train.csv\"\n",
        "test_url  = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/test.csv\"\n",
        "\n",
        "train = pd.read_csv(train_url)\n",
        "test = pd.read_csv(test_url)\n",
        "\n",
        "base_file = \"Group 5 Test Sub_MARKET_TUNED.csv\"\n",
        "base = pd.read_csv(base_file).rename(columns={\"Actual\": \"base_pred\"})\n",
        "\n",
        "df = test.merge(base, on=\"ID\", how=\"left\")\n",
        "\n",
        "def clean_text(d):\n",
        "    d = d.copy()\n",
        "    for c in [\"brand\", \"model\", \"transmission\", \"fuelType\"]:\n",
        "        d[c] = d[c].astype(str).str.strip().str.lower()\n",
        "    return d\n",
        "\n",
        "train = clean_text(train)\n",
        "df = clean_text(df)\n",
        "\n",
        "train_ref = train[(train[\"price\"] > 500) & (train[\"price\"] < 120000)].copy()\n",
        "\n",
        "# -------------------------------\n",
        "# Helper\n",
        "# -------------------------------\n",
        "\n",
        "def get_stats(group_cols, label):\n",
        "    s = (\n",
        "        train_ref\n",
        "        .groupby(group_cols, dropna=False)[\"price\"]\n",
        "        .agg(\n",
        "            median=\"median\",\n",
        "            count=\"count\",\n",
        "            q25=lambda x: np.percentile(x, 25),\n",
        "            q75=lambda x: np.percentile(x, 75)\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "    s[f\"{label}_anchor\"] = s[\"median\"]\n",
        "    s[f\"{label}_count\"] = s[\"count\"]\n",
        "    s[f\"{label}_iqr\"] = s[\"q75\"] - s[\"q25\"]\n",
        "    return s[group_cols + [f\"{label}_anchor\", f\"{label}_count\", f\"{label}_iqr\"]]\n",
        "\n",
        "exact_cols = [\"brand\", \"model\", \"year\", \"transmission\", \"fuelType\", \"tax\", \"mpg\", \"engineSize\"]\n",
        "spec_cols  = [\"brand\", \"model\", \"year\", \"transmission\", \"fuelType\", \"engineSize\"]\n",
        "\n",
        "exact_stats = get_stats(exact_cols, \"exact\")\n",
        "spec_stats = get_stats(spec_cols, \"spec\")\n",
        "\n",
        "x = df.merge(exact_stats, on=exact_cols, how=\"left\")\n",
        "x = x.merge(spec_stats, on=spec_cols, how=\"left\")\n",
        "\n",
        "# -------------------------------\n",
        "# Choose exact first, then spec\n",
        "# -------------------------------\n",
        "\n",
        "base_pred = x[\"base_pred\"].values.astype(float)\n",
        "\n",
        "exact_anchor = x[\"exact_anchor\"].values.astype(float)\n",
        "exact_count = x[\"exact_count\"].fillna(0).values.astype(float)\n",
        "exact_iqr = x[\"exact_iqr\"].values.astype(float)\n",
        "\n",
        "spec_anchor = x[\"spec_anchor\"].values.astype(float)\n",
        "spec_count = x[\"spec_count\"].fillna(0).values.astype(float)\n",
        "spec_iqr = x[\"spec_iqr\"].values.astype(float)\n",
        "\n",
        "exact_gap = np.abs(exact_anchor - base_pred) / base_pred\n",
        "spec_gap = np.abs(spec_anchor - base_pred) / base_pred\n",
        "\n",
        "exact_iqr_ratio = exact_iqr / np.maximum(exact_anchor, 1)\n",
        "spec_iqr_ratio = spec_iqr / np.maximum(spec_anchor, 1)\n",
        "\n",
        "use_exact = (\n",
        "    ~np.isnan(exact_anchor) &\n",
        "    (exact_count >= 4) &\n",
        "    (exact_gap <= 0.10) &\n",
        "    (exact_iqr_ratio <= 0.25)\n",
        ")\n",
        "\n",
        "use_spec = (\n",
        "    ~use_exact &\n",
        "    ~np.isnan(spec_anchor) &\n",
        "    (spec_count >= 8) &\n",
        "    (spec_gap <= 0.10) &\n",
        "    (spec_iqr_ratio <= 0.25)\n",
        ")\n",
        "\n",
        "chosen_anchor = np.where(use_exact, exact_anchor, np.where(use_spec, spec_anchor, base_pred))\n",
        "chosen_count = np.where(use_exact, exact_count, np.where(use_spec, spec_count, 0))\n",
        "chosen_gap = np.where(use_exact, exact_gap, np.where(use_spec, spec_gap, 0))\n",
        "\n",
        "valid = use_exact | use_spec\n",
        "\n",
        "print(\"Use exact:\", int(use_exact.sum()))\n",
        "print(\"Use spec:\", int(use_spec.sum()))\n",
        "print(\"Total adjusted:\", int(valid.sum()))\n",
        "\n",
        "# -------------------------------\n",
        "# Create versions\n",
        "# -------------------------------\n",
        "\n",
        "versions = {\n",
        "    \"micro\": 0.03,\n",
        "    \"small\": 0.05,\n",
        "    \"medium\": 0.07,\n",
        "}\n",
        "\n",
        "summary = []\n",
        "\n",
        "for name, max_weight in versions.items():\n",
        "    confidence = np.log1p(chosen_count) * (1 - chosen_gap)\n",
        "    weight = np.minimum(max_weight, confidence / 60)\n",
        "    weight = np.where(valid, weight, 0)\n",
        "\n",
        "    pred = (1 - weight) * base_pred + weight * chosen_anchor\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    out = pd.DataFrame({\n",
        "        \"ID\": x[\"ID\"],\n",
        "        \"Actual\": pred\n",
        "    })\n",
        "\n",
        "    filename = f\"Group 5 EXACT_SPEC_ANCHOR_{name}.csv\"\n",
        "    out.to_csv(filename, index=False)\n",
        "\n",
        "    move = pred - base_pred\n",
        "\n",
        "    summary.append({\n",
        "        \"file\": filename,\n",
        "        \"adjusted_rows\": int(valid.sum()),\n",
        "        \"avg_abs_move\": float(np.mean(np.abs(move[valid]))) if valid.sum() else 0,\n",
        "        \"mean_change_vs_base\": float(pred.mean() - base_pred.mean()),\n",
        "        \"median\": float(np.median(pred)),\n",
        "        \"missing\": int(np.isnan(pred).sum())\n",
        "    })\n",
        "\n",
        "summary_df = pd.DataFrame(summary)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"EXACT/SPEC ANCHOR SUMMARY\")\n",
        "print(\"==============================\")\n",
        "display(summary_df)\n",
        "\n",
        "print(\"Files created:\")\n",
        "for f in summary_df[\"file\"]:\n",
        "    print(\"-\", f)\n",
        "\n",
        "files.download(\"Group 5 EXACT_SPEC_ANCHOR_small.csv\")"
      ],
