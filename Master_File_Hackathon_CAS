      "source": [
        "# ===============================\n",
        "# IMPROVEMENT CELL 3 — CORRECT CELL\n",
        "# Multi-seed ensemble + validation weight search\n",
        "# Continue from the ORIGINAL 36-feature base\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_squared_error\n",
        "from lightgbm import LGBMRegressor\n",
        "from catboost import CatBoostRegressor, Pool\n",
        "\n",
        "def rmse(y_true, y_pred):\n",
        "    return np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "\n",
        "# -------------------------------\n",
        "# 1. Use original 36 features\n",
        "# -------------------------------\n",
        "\n",
        "features = original_features\n",
        "cat_features = original_cat_features\n",
        "cat_idx = original_cat_idx\n",
        "\n",
        "near_full_cols = [\n",
        "    \"brand\", \"model\", \"year\", \"transmission\",\n",
        "    \"fuelType\", \"tax\", \"mpg\", \"engineSize\"\n",
        "]\n",
        "\n",
        "train_part, val_part = train_test_split(\n",
        "    full_train,\n",
        "    test_size=0.30,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "X_tr = train_part[features].copy()\n",
        "y_tr = train_part[\"price\"].copy()\n",
        "y_tr_log = np.log1p(y_tr)\n",
        "\n",
        "X_val = val_part[features].copy()\n",
        "y_val = val_part[\"price\"].copy()\n",
        "\n",
        "X_tr_lgb = X_tr.copy()\n",
        "X_val_lgb = X_val.copy()\n",
        "\n",
        "for col in cat_features:\n",
        "    X_tr_lgb[col] = X_tr_lgb[col].astype(\"category\")\n",
        "    X_val_lgb[col] = X_val_lgb[col].astype(\"category\")\n",
        "\n",
        "# -------------------------------\n",
        "# 2. Train multi-seed models\n",
        "# -------------------------------\n",
        "\n",
        "seeds = [11, 42, 77, 123, 2026]\n",
        "\n",
        "val_preds = {\n",
        "    \"lgb_log\": [],\n",
        "    \"lgb_raw\": [],\n",
        "    \"cat_log\": [],\n",
        "    \"cat_raw\": []\n",
        "}\n",
        "\n",
        "for seed in seeds:\n",
        "    print(\"==============================\")\n",
        "    print(\"Training seed:\", seed)\n",
        "    print(\"==============================\")\n",
        "\n",
        "    lgb_log_s = LGBMRegressor(\n",
        "        n_estimators=2200,\n",
        "        learning_rate=0.018,\n",
        "        num_leaves=80,\n",
        "        max_depth=-1,\n",
        "        min_child_samples=25,\n",
        "        subsample=0.90,\n",
        "        colsample_bytree=0.90,\n",
        "        reg_alpha=0.05,\n",
        "        reg_lambda=0.5,\n",
        "        random_state=seed,\n",
        "        n_jobs=-1,\n",
        "        verbose=-1\n",
        "    )\n",
        "    lgb_log_s.fit(X_tr_lgb, y_tr_log)\n",
        "    val_preds[\"lgb_log\"].append(\n",
        "        np.clip(np.expm1(lgb_log_s.predict(X_val_lgb)), 500, None)\n",
        "    )\n",
        "\n",
        "    lgb_raw_s = LGBMRegressor(\n",
        "        n_estimators=2200,\n",
        "        learning_rate=0.018,\n",
        "        num_leaves=80,\n",
        "        max_depth=-1,\n",
        "        min_child_samples=25,\n",
        "        subsample=0.90,\n",
        "        colsample_bytree=0.90,\n",
        "        reg_alpha=0.05,\n",
        "        reg_lambda=0.5,\n",
        "        random_state=seed,\n",
        "        n_jobs=-1,\n",
        "        verbose=-1\n",
        "    )\n",
        "    lgb_raw_s.fit(X_tr_lgb, y_tr)\n",
        "    val_preds[\"lgb_raw\"].append(\n",
        "        np.clip(lgb_raw_s.predict(X_val_lgb), 500, None)\n",
        "    )\n",
        "\n",
        "    cat_log_s = CatBoostRegressor(\n",
        "        iterations=1400,\n",
        "        learning_rate=0.035,\n",
        "        depth=7,\n",
        "        l2_leaf_reg=6,\n",
        "        loss_function=\"RMSE\",\n",
        "        random_seed=seed,\n",
        "        verbose=0\n",
        "    )\n",
        "    cat_log_s.fit(Pool(X_tr, y_tr_log, cat_features=cat_idx))\n",
        "    val_preds[\"cat_log\"].append(\n",
        "        np.clip(np.expm1(cat_log_s.predict(X_val)), 500, None)\n",
        "    )\n",
        "\n",
        "    cat_raw_s = CatBoostRegressor(\n",
        "        iterations=1400,\n",
        "        learning_rate=0.035,\n",
        "        depth=7,\n",
        "        l2_leaf_reg=6,\n",
        "        loss_function=\"RMSE\",\n",
        "        random_seed=seed,\n",
        "        verbose=0\n",
        "    )\n",
        "    cat_raw_s.fit(Pool(X_tr, y_tr, cat_features=cat_idx))\n",
        "    val_preds[\"cat_raw\"].append(\n",
        "        np.clip(cat_raw_s.predict(X_val), 500, None)\n",
        "    )\n",
        "\n",
        "# -------------------------------\n",
        "# 3. Average model families\n",
        "# -------------------------------\n",
        "\n",
        "avg_preds = {\n",
        "    name: np.mean(pred_list, axis=0)\n",
        "    for name, pred_list in val_preds.items()\n",
        "}\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"INDIVIDUAL AVERAGED MODEL RMSE\")\n",
        "print(\"==============================\")\n",
        "\n",
        "for name, pred in avg_preds.items():\n",
        "    print(name, rmse(y_val, pred))\n",
        "\n",
        "# -------------------------------\n",
        "# 4. Search ensemble weights\n",
        "# -------------------------------\n",
        "\n",
        "model_names = [\"lgb_log\", \"lgb_raw\", \"cat_log\", \"cat_raw\"]\n",
        "\n",
        "candidate_weights = [\n",
        "    np.array([0.434783, 0.326087, 0.065217, 0.173913])\n",
        "]\n",
        "\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "for _ in range(3000):\n",
        "    candidate_weights.append(rng.dirichlet([5, 4, 1, 2]))\n",
        "\n",
        "best_base_rmse = 999999\n",
        "best_weights = None\n",
        "best_base_pred = None\n",
        "\n",
        "for w in candidate_weights:\n",
        "    pred = sum(w[i] * avg_preds[model_names[i]] for i in range(4))\n",
        "    pred = np.array(pred).copy()\n",
        "    pred[pred >= 39000] *= 1.009\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    score = rmse(y_val, pred)\n",
        "\n",
        "    if score < best_base_rmse:\n",
        "        best_base_rmse = score\n",
        "        best_weights = w\n",
        "        best_base_pred = pred\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"BEST MULTI-SEED BASE ENSEMBLE\")\n",
        "print(\"==============================\")\n",
        "print(\"Original base RMSE:\", 1934.325504)\n",
        "print(\"New base RMSE:\", best_base_rmse)\n",
        "print(\"Improvement:\", 1934.325504 - best_base_rmse)\n",
        "print(\"Weights:\")\n",
        "for name, weight in zip(model_names, best_weights):\n",
        "    print(name, round(float(weight), 6))\n",
        "\n",
        "# -------------------------------\n",
        "# 5. Anchor tuning on multi-seed base\n",
        "# -------------------------------\n",
        "\n",
        "anchor_results = []\n",
        "\n",
        "max_gaps = [0.10, 0.12, 0.15, 0.18]\n",
        "\n",
        "weight_sets = [\n",
        "    (0.15, 0.18, 0.15),\n",
        "    (0.18, 0.20, 0.16),\n",
        "    (0.20, 0.22, 0.18),\n",
        "    (0.22, 0.24, 0.18),\n",
        "    (0.25, 0.25, 0.20),\n",
        "    (0.28, 0.28, 0.22)\n",
        "]\n",
        "\n",
        "for gap in max_gaps:\n",
        "    for w_2_3, w_4_9, w_10_plus in weight_sets:\n",
        "\n",
        "        pred, info = apply_market_anchor(\n",
        "            train_ref=train_part,\n",
        "            target_ref=val_part,\n",
        "            base_pred=best_base_pred,\n",
        "            group_cols=near_full_cols,\n",
        "            max_gap=gap,\n",
        "            w_2_3=w_2_3,\n",
        "            w_4_9=w_4_9,\n",
        "            w_10_plus=w_10_plus\n",
        "        )\n",
        "\n",
        "        score = rmse(y_val, pred)\n",
        "\n",
        "        anchor_results.append({\n",
        "            \"max_gap\": gap,\n",
        "            \"w_2_3\": w_2_3,\n",
        "            \"w_4_9\": w_4_9,\n",
        "            \"w_10_plus\": w_10_plus,\n",
        "            \"rmse\": score,\n",
        "            **info\n",
        "        })\n",
        "\n",
        "anchor_results_df = (\n",
        "    pd.DataFrame(anchor_results)\n",
        "    .sort_values(\"rmse\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"TOP MULTI-SEED + ANCHOR CONFIGS\")\n",
        "print(\"==============================\")\n",
        "display(anchor_results_df.head(20))\n",
        "\n",
        "best_anchor = anchor_results_df.iloc[0].to_dict()\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"BEST RESULT SO FAR\")\n",
        "print(\"==============================\")\n",
        "print(\"Original anchored RMSE:\", 1925.399621)\n",
        "print(\"New best anchored RMSE:\", best_anchor[\"rmse\"])\n",
        "print(\"Improvement:\", 1925.399621 - best_anchor[\"rmse\"])\n",
        "print(\"Best anchor config:\", best_anchor)"
      ],
