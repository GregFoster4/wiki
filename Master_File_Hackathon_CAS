        "# ===============================\n",
        "# FAST HIGH-END PREMIUM ANCHOR TEST\n",
        "# Same idea, much smaller search\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "def rmse(y_true, y_pred):\n",
        "    return np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "\n",
        "base_pred = np.array(best_anchored_pred).copy()\n",
        "actual = np.array(y_val)\n",
        "baseline_rmse = rmse(actual, base_pred)\n",
        "\n",
        "print(\"Baseline RMSE:\", baseline_rmse)\n",
        "\n",
        "# -------------------------------\n",
        "# 1. Premium/high-end candidate mask\n",
        "# -------------------------------\n",
        "\n",
        "premium_models = [\n",
        "    \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "    \"gle class\", \"glc class\", \"v class\",\n",
        "    \"cls class\", \"sl class\", \"touareg\",\n",
        "    \"5 series\", \"e class\", \"a6\", \"a7\", \"a8\",\n",
        "    \"c class\", \"glc class\"\n",
        "]\n",
        "\n",
        "target_ref = val_part.copy().reset_index(drop=True)\n",
        "train_ref = train_part.copy().reset_index(drop=True)\n",
        "\n",
        "premium_mask = target_ref[\"model\"].isin(premium_models).values\n",
        "\n",
        "high_candidate_mask = (\n",
        "    premium_mask &\n",
        "    (\n",
        "        (base_pred >= 30000) |\n",
        "        ((target_ref[\"engineSize\"].values >= 3.0) & (target_ref[\"mileage\"].values <= 15000)) |\n",
        "        ((target_ref[\"year\"].values >= 2019) & (target_ref[\"mileage\"].values <= 5000))\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"High-end candidate rows:\", high_candidate_mask.sum())\n",
        "\n",
        "# -------------------------------\n",
        "# 2. Precompute anchors for only 3 group definitions\n",
        "# -------------------------------\n",
        "\n",
        "group_sets = {\n",
        "    \"brand_model_year_engine\": [\"brand\", \"model\", \"year\", \"engineSize\"],\n",
        "    \"brand_model_year\": [\"brand\", \"model\", \"year\"],\n",
        "    \"brand_model\": [\"brand\", \"model\"]\n",
        "}\n",
        "\n",
        "anchor_maps = {}\n",
        "\n",
        "for group_name, cols in group_sets.items():\n",
        "    stats = (\n",
        "        train_ref\n",
        "        .groupby(cols, dropna=False)[\"price\"]\n",
        "        .agg(\n",
        "            market_count=\"count\",\n",
        "            market_median=\"median\",\n",
        "            q65=lambda x: x.quantile(0.65),\n",
        "            q70=lambda x: x.quantile(0.70),\n",
        "            q75=lambda x: x.quantile(0.75)\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    tmp = target_ref[cols].copy()\n",
        "    tmp = tmp.merge(stats, on=cols, how=\"left\")\n",
        "\n",
        "    anchor_maps[group_name] = tmp\n",
        "\n",
        "# -------------------------------\n",
        "# 3. Fast search\n",
        "# -------------------------------\n",
        "\n",
        "rows = []\n",
        "\n",
        "for group_name, tmp in anchor_maps.items():\n",
        "    for q in [\"q65\", \"q70\", \"q75\"]:\n",
        "        for min_count in [3, 5, 8]:\n",
        "            for max_gap in [0.15, 0.20, 0.25]:\n",
        "                for alpha in [0.03, 0.05, 0.08, 0.10]:\n",
        "\n",
        "                    anchor = tmp[q]\n",
        "                    count = tmp[\"market_count\"]\n",
        "\n",
        "                    rel_gap = (anchor - base_pred).abs() / base_pred\n",
        "\n",
        "                    mask = (\n",
        "                        high_candidate_mask &\n",
        "                        anchor.notna().values &\n",
        "                        (count.values >= min_count) &\n",
        "                        (rel_gap.values <= max_gap) &\n",
        "                        (base_pred < anchor.values)\n",
        "                    )\n",
        "\n",
        "                    pred = base_pred.copy()\n",
        "                    pred[mask] = (1 - alpha) * pred[mask] + alpha * anchor.values[mask]\n",
        "                    pred = np.clip(pred, 500, None)\n",
        "\n",
        "                    score = rmse(actual, pred)\n",
        "\n",
        "                    rows.append({\n",
        "                        \"group_name\": group_name,\n",
        "                        \"quantile\": q,\n",
        "                        \"min_count\": min_count,\n",
        "                        \"max_gap\": max_gap,\n",
        "                        \"alpha\": alpha,\n",
        "                        \"adjusted_rows\": int(mask.sum()),\n",
        "                        \"rmse\": score,\n",
        "                        \"improvement\": baseline_rmse - score,\n",
        "                        \"mean_before\": float(base_pred[mask].mean()) if mask.sum() else np.nan,\n",
        "                        \"mean_anchor\": float(anchor.values[mask].mean()) if mask.sum() else np.nan\n",
        "                    })\n",
        "\n",
        "fast_high_results = (\n",
        "    pd.DataFrame(rows)\n",
        "    .sort_values(\"rmse\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"TOP FAST HIGH-END RESULTS\")\n",
        "print(\"==============================\")\n",
        "display(fast_high_results.head(30))\n",
        "\n",
        "best_fast_high = fast_high_results.iloc[0].to_dict()\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"BEST FAST HIGH-END RESULT\")\n",
        "print(\"==============================\")\n",
        "print(\"Baseline RMSE:\", baseline_rmse)\n",
        "print(\"Best RMSE:\", best_fast_high[\"rmse\"])\n",
        "print(\"Improvement:\", best_fast_high[\"improvement\"])\n",
        "print(\"Best config:\", best_fast_high)"
