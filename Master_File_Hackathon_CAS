      "source": [
        "# ===============================\n",
        "# EMERGENCY REBUILD CELL\n",
        "# Recreates final model + market-anchor submission from scratch\n",
        "# ===============================\n",
        "\n",
        "!pip -q install catboost lightgbm\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from lightgbm import LGBMRegressor\n",
        "from catboost import CatBoostRegressor, Pool\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "# -------------------------------\n",
        "# 1. Load data\n",
        "# -------------------------------\n",
        "\n",
        "train_url = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/train.csv\"\n",
        "test_url  = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/test.csv\"\n",
        "\n",
        "if os.path.exists(\"train.csv\"):\n",
        "    train_raw = pd.read_csv(\"train.csv\")\n",
        "else:\n",
        "    train_raw = pd.read_csv(train_url)\n",
        "\n",
        "if os.path.exists(\"test.csv\"):\n",
        "    test_raw = pd.read_csv(\"test.csv\")\n",
        "else:\n",
        "    test_raw = pd.read_csv(test_url)\n",
        "\n",
        "print(\"Loaded train:\", train_raw.shape)\n",
        "print(\"Loaded test:\", test_raw.shape)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 2. Feature engineering\n",
        "# -------------------------------\n",
        "\n",
        "def clean_text_cols(df):\n",
        "    df = df.copy()\n",
        "    for col in [\"brand\", \"model\", \"fuelType\", \"transmission\"]:\n",
        "        if col in df.columns:\n",
        "            df[col] = df[col].astype(str).str.strip().str.lower()\n",
        "    return df\n",
        "\n",
        "def add_features(df):\n",
        "    df = clean_text_cols(df)\n",
        "\n",
        "    df[\"car_age\"] = 2026 - df[\"year\"]\n",
        "    df[\"car_age\"] = df[\"car_age\"].clip(lower=0)\n",
        "\n",
        "    df[\"log_mileage\"] = np.log1p(df[\"mileage\"])\n",
        "\n",
        "    safe_age = df[\"car_age\"].replace(0, 1)\n",
        "    df[\"mileage_per_year\"] = df[\"mileage\"] / safe_age\n",
        "\n",
        "    df[\"engine_missing\"] = (df[\"engineSize\"] == 0).astype(int)\n",
        "    df[\"engineSize_clean\"] = df[\"engineSize\"].replace(0, np.nan)\n",
        "\n",
        "    df[\"log_tax\"] = np.log1p(df[\"tax\"])\n",
        "\n",
        "    df[\"engine_per_mpg\"] = df[\"engineSize_clean\"] / df[\"mpg\"].replace(0, np.nan)\n",
        "    df[\"tax_per_mpg\"] = df[\"tax\"] / df[\"mpg\"].replace(0, np.nan)\n",
        "\n",
        "    df[\"brand_model\"] = df[\"brand\"] + \"_\" + df[\"model\"]\n",
        "    df[\"brand_model_year\"] = df[\"brand_model\"] + \"_\" + df[\"year\"].astype(str)\n",
        "    df[\"brand_model_fuel\"] = df[\"brand_model\"] + \"_\" + df[\"fuelType\"]\n",
        "    df[\"brand_model_trans\"] = df[\"brand_model\"] + \"_\" + df[\"transmission\"]\n",
        "    df[\"brand_model_engine\"] = df[\"brand_model\"] + \"_\" + df[\"engineSize\"].astype(str)\n",
        "\n",
        "    df[\"age_x_mileage\"] = df[\"car_age\"] * df[\"mileage\"]\n",
        "    df[\"age_x_engine\"] = df[\"car_age\"] * df[\"engineSize_clean\"]\n",
        "\n",
        "    df = df.replace([np.inf, -np.inf], np.nan)\n",
        "    return df\n",
        "\n",
        "def add_premium_features(df):\n",
        "    df = df.copy()\n",
        "\n",
        "    premium_models = [\n",
        "        \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "        \"gle class\", \"glc class\", \"v class\",\n",
        "        \"cls class\", \"sl class\", \"touareg\"\n",
        "    ]\n",
        "\n",
        "    luxury_suv_models = [\n",
        "        \"q7\", \"q5\", \"x5\", \"x3\",\n",
        "        \"gle class\", \"glc class\", \"touareg\"\n",
        "    ]\n",
        "\n",
        "    performance_models = [\"sl class\", \"tt\", \"cls class\"]\n",
        "\n",
        "    df[\"is_premium_model\"] = df[\"model\"].isin(premium_models).astype(int)\n",
        "    df[\"is_luxury_suv\"] = df[\"model\"].isin(luxury_suv_models).astype(int)\n",
        "    df[\"is_performance_model\"] = df[\"model\"].isin(performance_models).astype(int)\n",
        "\n",
        "    df[\"large_engine\"] = (df[\"engineSize\"] >= 3.0).astype(int)\n",
        "    df[\"very_large_engine\"] = (df[\"engineSize\"] >= 4.0).astype(int)\n",
        "\n",
        "    df[\"very_low_mileage\"] = (df[\"mileage\"] <= 2000).astype(int)\n",
        "    df[\"low_mileage\"] = (df[\"mileage\"] <= 10000).astype(int)\n",
        "    df[\"new_low_mileage\"] = ((df[\"car_age\"] <= 7) & (df[\"mileage\"] <= 10000)).astype(int)\n",
        "\n",
        "    df[\"premium_large_engine\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) & (df[\"engineSize\"] >= 3.0)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"premium_low_mileage\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) & (df[\"mileage\"] <= 10000)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"luxury_suv_large_engine\"] = (\n",
        "        (df[\"is_luxury_suv\"] == 1) & (df[\"engineSize\"] >= 3.0)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"premium_new_low_mileage\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) &\n",
        "        (df[\"car_age\"] <= 7) &\n",
        "        (df[\"mileage\"] <= 10000)\n",
        "    ).astype(int)\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 3. Prepare final train/test\n",
        "# -------------------------------\n",
        "\n",
        "final_train = add_features(train_raw.copy())\n",
        "final_train = final_train[\n",
        "    (final_train[\"price\"] > 500) &\n",
        "    (final_train[\"price\"] < 120000)\n",
        "].copy()\n",
        "\n",
        "final_test = add_features(test_raw.copy())\n",
        "\n",
        "final_train = add_premium_features(final_train)\n",
        "final_test = add_premium_features(final_test)\n",
        "\n",
        "numeric_keep = [\n",
        "    \"year\", \"car_age\", \"mileage\", \"log_mileage\", \"mileage_per_year\",\n",
        "    \"age_x_mileage\", \"engineSize\", \"engineSize_clean\", \"tax\", \"log_tax\",\n",
        "    \"mpg\", \"engine_per_mpg\", \"tax_per_mpg\"\n",
        "]\n",
        "\n",
        "numeric_maybe = [\"engine_missing\", \"age_x_engine\"]\n",
        "\n",
        "categorical_keep = [\n",
        "    \"model\", \"brand_model\", \"brand_model_year\", \"brand_model_fuel\",\n",
        "    \"brand_model_trans\", \"brand_model_engine\"\n",
        "]\n",
        "\n",
        "categorical_maybe = [\"brand\", \"fuelType\", \"transmission\"]\n",
        "\n",
        "premium_features = [\n",
        "    \"is_premium_model\", \"is_luxury_suv\", \"is_performance_model\",\n",
        "    \"large_engine\", \"very_large_engine\", \"very_low_mileage\",\n",
        "    \"low_mileage\", \"new_low_mileage\", \"premium_large_engine\",\n",
        "    \"premium_low_mileage\", \"luxury_suv_large_engine\",\n",
        "    \"premium_new_low_mileage\"\n",
        "]\n",
        "\n",
        "final_features = numeric_keep + numeric_maybe + categorical_keep + categorical_maybe + premium_features\n",
        "final_features = [f for f in final_features if f in final_train.columns]\n",
        "\n",
        "final_cat_features = [\n",
        "    f for f in final_features\n",
        "    if final_train[f].dtype == \"object\" or str(final_train[f].dtype) == \"category\"\n",
        "]\n",
        "\n",
        "X_train = final_train[final_features].copy()\n",
        "y_train = final_train[\"price\"].copy()\n",
        "y_train_log = np.log1p(y_train)\n",
        "\n",
        "X_test = final_test[final_features].copy()\n",
        "\n",
        "X_train_lgb = X_train.copy()\n",
        "X_test_lgb = X_test.copy()\n",
        "\n",
        "for col in final_cat_features:\n",
        "    X_train_lgb[col] = X_train_lgb[col].astype(\"category\")\n",
        "    X_test_lgb[col] = X_test_lgb[col].astype(\"category\")\n",
        "\n",
        "cat_idx = [final_features.index(c) for c in final_cat_features]\n",
        "\n",
        "print(\"Final train:\", final_train.shape)\n",
        "print(\"Final test:\", final_test.shape)\n",
        "print(\"Features:\", len(final_features))\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 4. Train final models\n",
        "# -------------------------------\n",
        "\n",
        "print(\"Training LGBM log...\")\n",
        "lgb_log = LGBMRegressor(\n",
        "    n_estimators=2200,\n",
        "    learning_rate=0.018,\n",
        "    num_leaves=80,\n",
        "    max_depth=-1,\n",
        "    min_child_samples=25,\n",
        "    subsample=0.90,\n",
        "    colsample_bytree=0.90,\n",
        "    reg_alpha=0.05,\n",
        "    reg_lambda=0.5,\n",
        "    random_state=RANDOM_STATE,\n",
        "    n_jobs=-1,\n",
        "    verbose=-1\n",
        ")\n",
        "lgb_log.fit(X_train_lgb, y_train_log)\n",
        "pred_lgb_log = np.expm1(lgb_log.predict(X_test_lgb))\n",
        "\n",
        "print(\"Training LGBM raw...\")\n",
        "lgb_raw = LGBMRegressor(\n",
        "    n_estimators=2200,\n",
        "    learning_rate=0.018,\n",
        "    num_leaves=80,\n",
        "    max_depth=-1,\n",
        "    min_child_samples=25,\n",
        "    subsample=0.90,\n",
        "    colsample_bytree=0.90,\n",
        "    reg_alpha=0.05,\n",
        "    reg_lambda=0.5,\n",
        "    random_state=RANDOM_STATE,\n",
        "    n_jobs=-1,\n",
        "    verbose=-1\n",
        ")\n",
        "lgb_raw.fit(X_train_lgb, y_train)\n",
        "pred_lgb_raw = np.clip(lgb_raw.predict(X_test_lgb), 500, None)\n",
        "\n",
        "print(\"Training CatBoost log...\")\n",
        "cat_log = CatBoostRegressor(\n",
        "    iterations=1400,\n",
        "    learning_rate=0.035,\n",
        "    depth=7,\n",
        "    l2_leaf_reg=6,\n",
        "    loss_function=\"RMSE\",\n",
        "    random_seed=RANDOM_STATE,\n",
        "    verbose=0\n",
        ")\n",
        "cat_log.fit(Pool(X_train, y_train_log, cat_features=cat_idx))\n",
        "pred_cat_log = np.expm1(cat_log.predict(X_test))\n",
        "\n",
        "print(\"Training CatBoost raw...\")\n",
        "cat_raw = CatBoostRegressor(\n",
        "    iterations=1400,\n",
        "    learning_rate=0.035,\n",
        "    depth=7,\n",
        "    l2_leaf_reg=6,\n",
        "    loss_function=\"RMSE\",\n",
        "    random_seed=RANDOM_STATE,\n",
        "    verbose=0\n",
        ")\n",
        "cat_raw.fit(Pool(X_train, y_train, cat_features=cat_idx))\n",
        "pred_cat_raw = np.clip(cat_raw.predict(X_test), 500, None)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 5. Base ensemble + correction\n",
        "# -------------------------------\n",
        "\n",
        "base_pred = (\n",
        "    0.434783 * pred_lgb_log +\n",
        "    0.326087 * pred_lgb_raw +\n",
        "    0.065217 * pred_cat_log +\n",
        "    0.173913 * pred_cat_raw\n",
        ")\n",
        "\n",
        "base_pred = base_pred.copy()\n",
        "base_pred[base_pred >= 39000] *= 1.009\n",
        "base_pred = np.clip(base_pred, 500, None)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 6. Confidence-weighted selective market anchor\n",
        "# -------------------------------\n",
        "\n",
        "near_full_cols = [\n",
        "    \"brand\", \"model\", \"year\", \"transmission\",\n",
        "    \"fuelType\", \"tax\", \"mpg\", \"engineSize\"\n",
        "]\n",
        "\n",
        "market_stats = (\n",
        "    final_train\n",
        "    .groupby(near_full_cols, dropna=False)[\"price\"]\n",
        "    .agg([\"median\", \"count\"])\n",
        "    .reset_index()\n",
        "    .rename(columns={\n",
        "        \"median\": \"market_median\",\n",
        "        \"count\": \"market_count\"\n",
        "    })\n",
        ")\n",
        "\n",
        "test_market = final_test[near_full_cols].copy()\n",
        "test_market[\"base_pred\"] = base_pred\n",
        "\n",
        "test_market = test_market.merge(\n",
        "    market_stats,\n",
        "    on=near_full_cols,\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "test_market[\"relative_gap\"] = (\n",
        "    (test_market[\"market_median\"] - test_market[\"base_pred\"]).abs()\n",
        "    / test_market[\"base_pred\"]\n",
        ")\n",
        "\n",
        "final_pred = test_market[\"base_pred\"].copy()\n",
        "\n",
        "valid = (\n",
        "    test_market[\"market_median\"].notna() &\n",
        "    (test_market[\"market_count\"] >= 2) &\n",
        "    (test_market[\"relative_gap\"] <= 0.15)\n",
        ")\n",
        "\n",
        "mask_2_3 = valid & (test_market[\"market_count\"] >= 2) & (test_market[\"market_count\"] < 4)\n",
        "mask_4_9 = valid & (test_market[\"market_count\"] >= 4) & (test_market[\"market_count\"] < 10)\n",
        "mask_10_plus = valid & (test_market[\"market_count\"] >= 10)\n",
        "\n",
        "final_pred.loc[mask_2_3] = (\n",
        "    0.80 * final_pred.loc[mask_2_3] +\n",
        "    0.20 * test_market.loc[mask_2_3, \"market_median\"]\n",
        ")\n",
        "\n",
        "final_pred.loc[mask_4_9] = (\n",
        "    0.78 * final_pred.loc[mask_4_9] +\n",
        "    0.22 * test_market.loc[mask_4_9, \"market_median\"]\n",
        ")\n",
        "\n",
        "final_pred.loc[mask_10_plus] = (\n",
        "    0.82 * final_pred.loc[mask_10_plus] +\n",
        "    0.18 * test_market.loc[mask_10_plus, \"market_median\"]\n",
        ")\n",
        "\n",
        "final_pred = np.clip(final_pred, 500, None)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 7. Save final file\n",
        "# -------------------------------\n",
        "\n",
        "submission = pd.DataFrame({\n",
        "    \"ID\": test_raw[\"ID\"],\n",
        "    \"Actual\": final_pred\n",
        "})\n",
        "\n",
        "filename = \"Group 5 Test Sub_CONFIDENCE_FINAL.csv\"\n",
        "submission.to_csv(filename, index=False)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"REBUILT FINAL SUBMISSION\")\n",
        "print(\"==============================\")\n",
        "print(\"Rows:\", submission.shape[0])\n",
        "print(\"Missing:\", submission[\"Actual\"].isna().sum())\n",
        "print(\"Adjusted rows:\", int(valid.sum()))\n",
        "print(\"2-3 count rows:\", int(mask_2_3.sum()))\n",
        "print(\"4-9 count rows:\", int(mask_4_9.sum()))\n",
        "print(\"10+ count rows:\", int(mask_10_plus.sum()))\n",
        "print(\"Min:\", round(final_pred.min(), 2))\n",
        "print(\"Median:\", round(np.median(final_pred), 2))\n",
        "print(\"Mean:\", round(final_pred.mean(), 2))\n",
        "print(\"Max:\", round(final_pred.max(), 2))\n",
        "\n",
        "display(submission.head())\n",
        "\n",
        "try:\n",
        "    from google.colab import files\n",
        "    files.download(filename)\n",
        "except:\n",
        "    print(\"Saved locally:\", filename)"
      ],
