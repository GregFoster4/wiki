        "# ===============================\n",
        "# FIXED ROBUST HIERARCHICAL ANCHOR\n",
        "# No NaNs, stricter, safer\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "\n",
        "train_url = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/train.csv\"\n",
        "test_url  = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/test.csv\"\n",
        "\n",
        "train = pd.read_csv(train_url)\n",
        "test = pd.read_csv(test_url)\n",
        "\n",
        "base_file = \"Group 5 Test Sub_MARKET_TUNED.csv\"\n",
        "base = pd.read_csv(base_file).rename(columns={\"Actual\": \"base_pred\"})\n",
        "\n",
        "df = test.merge(base, on=\"ID\", how=\"left\")\n",
        "\n",
        "if df[\"base_pred\"].isna().sum() > 0:\n",
        "    raise ValueError(\"Base prediction merge failed.\")\n",
        "\n",
        "def clean_text(df):\n",
        "    df = df.copy()\n",
        "    for c in [\"brand\", \"model\", \"transmission\", \"fuelType\"]:\n",
        "        df[c] = df[c].astype(str).str.strip().str.lower()\n",
        "    return df\n",
        "\n",
        "train = clean_text(train)\n",
        "df = clean_text(df)\n",
        "\n",
        "train_ref = train[(train[\"price\"] > 500) & (train[\"price\"] < 120000)].copy()\n",
        "\n",
        "# -------------------------------\n",
        "# Anchor builder\n",
        "# -------------------------------\n",
        "\n",
        "def add_anchor(target, train_ref, group_cols, label):\n",
        "    stats = (\n",
        "        train_ref\n",
        "        .groupby(group_cols, dropna=False)[\"price\"]\n",
        "        .agg(\n",
        "            anchor=\"median\",\n",
        "            count=\"count\",\n",
        "            q25=lambda x: np.percentile(x, 25),\n",
        "            q75=lambda x: np.percentile(x, 75)\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    stats[f\"{label}_anchor\"] = stats[\"anchor\"]\n",
        "    stats[f\"{label}_count\"] = stats[\"count\"]\n",
        "    stats[f\"{label}_iqr\"] = stats[\"q75\"] - stats[\"q25\"]\n",
        "\n",
        "    keep = group_cols + [f\"{label}_anchor\", f\"{label}_count\", f\"{label}_iqr\"]\n",
        "    return target.merge(stats[keep], on=group_cols, how=\"left\")\n",
        "\n",
        "anchor_specs = [\n",
        "    (\"exact\", [\"brand\", \"model\", \"year\", \"transmission\", \"fuelType\", \"tax\", \"mpg\", \"engineSize\"]),\n",
        "    (\"spec\", [\"brand\", \"model\", \"year\", \"transmission\", \"fuelType\", \"engineSize\"]),\n",
        "    (\"engine\", [\"brand\", \"model\", \"year\", \"engineSize\"]),\n",
        "    (\"year\", [\"brand\", \"model\", \"year\"]),\n",
        "]\n",
        "\n",
        "anchored = df.copy()\n",
        "\n",
        "for label, cols in anchor_specs:\n",
        "    anchored = add_anchor(anchored, train_ref, cols, label)\n",
        "\n",
        "# -------------------------------\n",
        "# Choose best credible anchor\n",
        "# -------------------------------\n",
        "\n",
        "def choose_best_anchor(row):\n",
        "    base = row[\"base_pred\"]\n",
        "\n",
        "    rules = [\n",
        "        # label, min_count, max_gap, max_iqr_ratio\n",
        "        (\"exact\", 3, 0.12, 0.30),\n",
        "        (\"spec\", 5, 0.12, 0.28),\n",
        "        (\"engine\", 8, 0.14, 0.30),\n",
        "        (\"year\", 12, 0.16, 0.32),\n",
        "    ]\n",
        "\n",
        "    best_anchor = np.nan\n",
        "    best_conf = 0\n",
        "    best_label = \"none\"\n",
        "\n",
        "    for label, min_count, max_gap, max_iqr_ratio in rules:\n",
        "        anchor = row.get(f\"{label}_anchor\")\n",
        "        count = row.get(f\"{label}_count\")\n",
        "        iqr = row.get(f\"{label}_iqr\")\n",
        "\n",
        "        if pd.isna(anchor) or pd.isna(count) or count < min_count:\n",
        "            continue\n",
        "\n",
        "        rel_gap = abs(anchor - base) / max(base, 1)\n",
        "        iqr_ratio = iqr / max(anchor, 1)\n",
        "\n",
        "        if rel_gap > max_gap:\n",
        "            continue\n",
        "\n",
        "        if iqr_ratio > max_iqr_ratio:\n",
        "            continue\n",
        "\n",
        "        conf = np.log1p(count) * (1 - rel_gap) * (1 - min(iqr_ratio, 0.9))\n",
        "\n",
        "        if conf > best_conf:\n",
        "            best_conf = conf\n",
        "            best_anchor = anchor\n",
        "            best_label = label\n",
        "\n",
        "    return pd.Series([best_anchor, best_conf, best_label])\n",
        "\n",
        "anchored[[\"best_anchor\", \"anchor_conf\", \"anchor_level\"]] = anchored.apply(choose_best_anchor, axis=1)\n",
        "\n",
        "# -------------------------------\n",
        "# Apply safe anchor\n",
        "# -------------------------------\n",
        "\n",
        "def make_version(data, name, max_weight, min_conf, max_move):\n",
        "    base_pred = data[\"base_pred\"].values.astype(float)\n",
        "    anchor = data[\"best_anchor\"].values.astype(float)\n",
        "    conf = data[\"anchor_conf\"].values.astype(float)\n",
        "\n",
        "    valid = (~np.isnan(anchor)) & (conf >= min_conf)\n",
        "\n",
        "    # IMPORTANT: replace NaN anchors with base prediction before multiplying\n",
        "    safe_anchor = np.where(valid, anchor, base_pred)\n",
        "\n",
        "    weight = np.minimum(max_weight, conf / 35)\n",
        "    weight = np.where(valid, weight, 0)\n",
        "\n",
        "    proposed = (1 - weight) * base_pred + weight * safe_anchor\n",
        "\n",
        "    move = proposed - base_pred\n",
        "    move_cap = max_move * base_pred\n",
        "    move = np.clip(move, -move_cap, move_cap)\n",
        "\n",
        "    final = base_pred + move\n",
        "    final = np.clip(final, 500, None)\n",
        "\n",
        "    out = pd.DataFrame({\n",
        "        \"ID\": data[\"ID\"],\n",
        "        \"Actual\": final\n",
        "    })\n",
        "\n",
        "    filename = f\"Group 5 FIXED_HIER_{name}.csv\"\n",
        "    out.to_csv(filename, index=False)\n",
        "\n",
        "    return {\n",
        "        \"file\": filename,\n",
        "        \"adjusted_rows\": int(valid.sum()),\n",
        "        \"avg_abs_move\": float(np.mean(np.abs(move[valid]))) if valid.sum() else 0,\n",
        "        \"mean_pred\": float(np.mean(final)),\n",
        "        \"median_pred\": float(np.median(final)),\n",
        "        \"min_pred\": float(np.min(final)),\n",
        "        \"max_pred\": float(np.max(final)),\n",
        "        \"missing\": int(np.isnan(final).sum()),\n",
        "        \"mean_change_vs_base\": float(np.mean(final) - np.mean(base_pred))\n",
        "    }\n",
        "\n",
        "versions = [\n",
        "    make_version(anchored, \"very_conservative\", max_weight=0.04, min_conf=1.8, max_move=0.025),\n",
        "    make_version(anchored, \"conservative\", max_weight=0.06, min_conf=1.6, max_move=0.035),\n",
        "    make_version(anchored, \"balanced\", max_weight=0.08, min_conf=1.4, max_move=0.045),\n",
        "]\n",
        "\n",
        "summary_df = pd.DataFrame(versions)\n",
        "\n",
        "print(\"==============================\")\n",
