        "# ===============================\n",
        "# CREATE REFINED HIGH-END SUBMISSION\n",
        "# Save as: Group 5 tuning test.csv\n",
        "#\n",
        "# Best validation rule:\n",
        "# q70, alpha 0.10, min_pred 35000,\n",
        "# min_abs_lift 500, max_gap 0.25, min_count 8\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# -------------------------------\n",
        "# 1. Load base submission\n",
        "# -------------------------------\n",
        "\n",
        "base_file = \"Group 5 Test Sub_MARKET_TUNED.csv\"\n",
        "\n",
        "base_submission = pd.read_csv(base_file)\n",
        "base_submission = base_submission.rename(columns={\"Actual\": \"base_pred\"})\n",
        "\n",
        "print(\"Using base file:\", base_file)\n",
        "print(base_submission.head())\n",
        "\n",
        "# -------------------------------\n",
        "# 2. Prepare train/test references\n",
        "# -------------------------------\n",
        "\n",
        "test_ref = full_test.copy().reset_index(drop=True)\n",
        "train_ref = full_train.copy().reset_index(drop=True)\n",
        "\n",
        "df = test_ref.copy()\n",
        "\n",
        "# Use ID from test_raw if available, otherwise from base file\n",
        "if \"test_raw\" in globals() and \"ID\" in test_raw.columns:\n",
        "    df[\"ID\"] = test_raw[\"ID\"].values\n",
        "else:\n",
        "    df[\"ID\"] = base_submission[\"ID\"].values\n",
        "\n",
        "df[\"base_pred\"] = base_submission[\"base_pred\"].values\n",
        "\n",
        "# -------------------------------\n",
        "# 3. Define premium/high-end candidate rows\n",
        "# -------------------------------\n",
        "\n",
        "premium_models = [\n",
        "    \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "    \"gle class\", \"glc class\", \"v class\",\n",
        "    \"cls class\", \"sl class\", \"touareg\",\n",
        "    \"5 series\", \"e class\", \"a6\", \"a7\", \"a8\",\n",
        "    \"c class\"\n",
        "]\n",
        "\n",
        "premium_mask = df[\"model\"].isin(premium_models).values\n",
        "\n",
        "high_candidate_mask = (\n",
        "    premium_mask &\n",
        "    (\n",
        "        (df[\"base_pred\"].values >= 35000) |\n",
        "        ((df[\"engineSize\"].values >= 3.0) & (df[\"mileage\"].values <= 12000)) |\n",
        "        ((df[\"year\"].values >= 2019) & (df[\"mileage\"].values <= 3000))\n",
        "    )\n",
        ")\n",
        "\n",
        "# -------------------------------\n",
        "# 4. Build market q70 anchor from train\n",
        "# -------------------------------\n",
        "\n",
        "group_cols = [\"brand\", \"model\", \"year\"]\n",
        "\n",
        "stats = (\n",
        "    train_ref\n",
        "    .groupby(group_cols, dropna=False)[\"price\"]\n",
        "    .agg(\n",
        "        market_count=\"count\",\n",
        "        market_median=\"median\",\n",
        "        q70=lambda x: x.quantile(0.70)\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "tmp = df[group_cols + [\"base_pred\"]].copy()\n",
        "tmp = tmp.merge(stats, on=group_cols, how=\"left\")\n",
        "\n",
        "anchor = tmp[\"q70\"].values\n",
        "count = tmp[\"market_count\"].values\n",
        "base_pred = tmp[\"base_pred\"].values\n",
        "\n",
        "rel_gap = np.abs(anchor - base_pred) / base_pred\n",
        "abs_lift = anchor - base_pred\n",
        "\n",
        "# -------------------------------\n",
        "# 5. Apply refined high-end rule\n",
        "# -------------------------------\n",
        "\n",
        "mask = (\n",
        "    high_candidate_mask &\n",
        "    ~pd.isna(anchor) &\n",
        "    (count >= 8) &\n",
        "    (rel_gap <= 0.25) &\n",
        "    (abs_lift >= 500)\n",
        ")\n",
        "\n",
        "alpha = 0.10\n",
        "\n",
        "final_pred = base_pred.copy()\n",
        "final_pred[mask] = (1 - alpha) * final_pred[mask] + alpha * anchor[mask]\n",
        "final_pred = np.clip(final_pred, 500, None)\n",
        "\n",
        "# -------------------------------\n",
        "# 6. Diagnostics\n",
        "# -------------------------------\n",
        "\n",
        "changed = pd.DataFrame({\n",
        "    \"ID\": df[\"ID\"],\n",
        "    \"brand\": df[\"brand\"],\n",
        "    \"model\": df[\"model\"],\n",
        "    \"year\": df[\"year\"],\n",
        "    \"mileage\": df[\"mileage\"],\n",
        "    \"engineSize\": df[\"engineSize\"],\n",
        "    \"before\": base_pred,\n",
        "    \"anchor_q70\": anchor,\n",
        "    \"after\": final_pred,\n",
        "    \"adjustment\": final_pred - base_pred\n",
        "})\n",
        "\n",
        "changed = changed[mask].sort_values(\"adjustment\", ascending=False)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"REFINED HIGH-END SUBMISSION DIAGNOSTICS\")\n",
        "print(\"==============================\")\n",
        "print(\"Rows adjusted:\", int(mask.sum()))\n",
        "print(\"Mean before:\", round(base_pred.mean(), 2))\n",
        "print(\"Mean after:\", round(final_pred.mean(), 2))\n",
        "print(\"Median before:\", round(np.median(base_pred), 2))\n",
        "print(\"Median after:\", round(np.median(final_pred), 2))\n",
        "print(\"Max before:\", round(base_pred.max(), 2))\n",
        "print(\"Max after:\", round(final_pred.max(), 2))\n",
        "\n",
        "if len(changed) > 0:\n",
        "    print(\"Average adjustment:\", round(changed[\"adjustment\"].mean(), 2))\n",
        "    print(\"Max adjustment:\", round(changed[\"adjustment\"].max(), 2))\n",
        "else:\n",
        "    print(\"Average adjustment: 0\")\n",
        "    print(\"Max adjustment: 0\")\n",
        "\n",
        "display(changed.head(50))\n",
        "\n",
        "# -------------------------------\n",
        "# 7. Save submission\n",
        "# -------------------------------\n",
        "\n",
        "submission = pd.DataFrame({\n",
        "    \"ID\": df[\"ID\"],\n",
        "    \"Actual\": final_pred\n",
