    {
      "cell_type": "code",
      "source": [
        "# ===============================\n",
        "# IMPROVEMENT CELL 1\n",
        "# Validation split + market-anchor tuning + new submission\n",
        "# ===============================\n",
        "\n",
        "!pip -q install catboost lightgbm\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "from lightgbm import LGBMRegressor\n",
        "from catboost import CatBoostRegressor, Pool\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "# -------------------------------\n",
        "# 1. Load data\n",
        "# -------------------------------\n",
        "\n",
        "train_url = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/train.csv\"\n",
        "test_url  = \"https://github.com/casbdai/notebooks/raw/main/Module3/99_CAS_BDAI_CUP/test.csv\"\n",
        "\n",
        "train_raw = pd.read_csv(\"train.csv\") if os.path.exists(\"train.csv\") else pd.read_csv(train_url)\n",
        "test_raw  = pd.read_csv(\"test.csv\") if os.path.exists(\"test.csv\") else pd.read_csv(test_url)\n",
        "\n",
        "print(\"Loaded train:\", train_raw.shape)\n",
        "print(\"Loaded test:\", test_raw.shape)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 2. Feature engineering\n",
        "# -------------------------------\n",
        "\n",
        "def clean_text_cols(df):\n",
        "    df = df.copy()\n",
        "    for col in [\"brand\", \"model\", \"fuelType\", \"transmission\"]:\n",
        "        if col in df.columns:\n",
        "            df[col] = df[col].astype(str).str.strip().str.lower()\n",
        "    return df\n",
        "\n",
        "def add_features(df):\n",
        "    df = clean_text_cols(df)\n",
        "\n",
        "    df[\"car_age\"] = 2026 - df[\"year\"]\n",
        "    df[\"car_age\"] = df[\"car_age\"].clip(lower=0)\n",
        "\n",
        "    df[\"log_mileage\"] = np.log1p(df[\"mileage\"])\n",
        "\n",
        "    safe_age = df[\"car_age\"].replace(0, 1)\n",
        "    df[\"mileage_per_year\"] = df[\"mileage\"] / safe_age\n",
        "\n",
        "    df[\"engine_missing\"] = (df[\"engineSize\"] == 0).astype(int)\n",
        "    df[\"engineSize_clean\"] = df[\"engineSize\"].replace(0, np.nan)\n",
        "\n",
        "    df[\"log_tax\"] = np.log1p(df[\"tax\"])\n",
        "\n",
        "    df[\"engine_per_mpg\"] = df[\"engineSize_clean\"] / df[\"mpg\"].replace(0, np.nan)\n",
        "    df[\"tax_per_mpg\"] = df[\"tax\"] / df[\"mpg\"].replace(0, np.nan)\n",
        "\n",
        "    df[\"brand_model\"] = df[\"brand\"] + \"_\" + df[\"model\"]\n",
        "    df[\"brand_model_year\"] = df[\"brand_model\"] + \"_\" + df[\"year\"].astype(str)\n",
        "    df[\"brand_model_fuel\"] = df[\"brand_model\"] + \"_\" + df[\"fuelType\"]\n",
        "    df[\"brand_model_trans\"] = df[\"brand_model\"] + \"_\" + df[\"transmission\"]\n",
        "    df[\"brand_model_engine\"] = df[\"brand_model\"] + \"_\" + df[\"engineSize\"].astype(str)\n",
        "    df[\"brand_model_year_engine\"] = df[\"brand_model_year\"] + \"_\" + df[\"engineSize\"].astype(str)\n",
        "\n",
        "    df[\"age_x_mileage\"] = df[\"car_age\"] * df[\"mileage\"]\n",
        "    df[\"age_x_engine\"] = df[\"car_age\"] * df[\"engineSize_clean\"]\n",
        "\n",
        "    df = df.replace([np.inf, -np.inf], np.nan)\n",
        "    return df\n",
        "\n",
        "def add_premium_features(df):\n",
        "    df = df.copy()\n",
        "\n",
        "    premium_models = [\n",
        "        \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "        \"gle class\", \"glc class\", \"v class\",\n",
        "        \"cls class\", \"sl class\", \"touareg\"\n",
        "    ]\n",
        "\n",
        "    luxury_suv_models = [\n",
        "        \"q7\", \"q5\", \"x5\", \"x3\",\n",
        "        \"gle class\", \"glc class\", \"touareg\"\n",
        "    ]\n",
        "\n",
        "    performance_models = [\"sl class\", \"tt\", \"cls class\"]\n",
        "\n",
        "    df[\"is_premium_model\"] = df[\"model\"].isin(premium_models).astype(int)\n",
        "    df[\"is_luxury_suv\"] = df[\"model\"].isin(luxury_suv_models).astype(int)\n",
        "    df[\"is_performance_model\"] = df[\"model\"].isin(performance_models).astype(int)\n",
        "\n",
        "    df[\"large_engine\"] = (df[\"engineSize\"] >= 3.0).astype(int)\n",
        "    df[\"very_large_engine\"] = (df[\"engineSize\"] >= 4.0).astype(int)\n",
        "\n",
        "    df[\"very_low_mileage\"] = (df[\"mileage\"] <= 2000).astype(int)\n",
        "    df[\"low_mileage\"] = (df[\"mileage\"] <= 10000).astype(int)\n",
        "    df[\"new_low_mileage\"] = ((df[\"car_age\"] <= 7) & (df[\"mileage\"] <= 10000)).astype(int)\n",
        "\n",
        "    df[\"premium_large_engine\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) & (df[\"engineSize\"] >= 3.0)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"premium_low_mileage\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) & (df[\"mileage\"] <= 10000)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"luxury_suv_large_engine\"] = (\n",
        "        (df[\"is_luxury_suv\"] == 1) & (df[\"engineSize\"] >= 3.0)\n",
        "    ).astype(int)\n",
        "\n",
        "    df[\"premium_new_low_mileage\"] = (\n",
        "        (df[\"is_premium_model\"] == 1) &\n",
        "        (df[\"car_age\"] <= 7) &\n",
        "        (df[\"mileage\"] <= 10000)\n",
        "    ).astype(int)\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 3. Prepare full data\n",
        "# -------------------------------\n",
        "\n",
        "full_train = add_features(train_raw.copy())\n",
        "full_train = full_train[\n",
        "    (full_train[\"price\"] > 500) &\n",
        "    (full_train[\"price\"] < 120000)\n",
        "].copy()\n",
        "\n",
        "full_test = add_features(test_raw.copy())\n",
        "\n",
        "full_train = add_premium_features(full_train)\n",
        "full_test = add_premium_features(full_test)\n",
        "\n",
        "numeric_keep = [\n",
        "    \"year\", \"car_age\", \"mileage\", \"log_mileage\", \"mileage_per_year\",\n",
        "    \"age_x_mileage\", \"engineSize\", \"engineSize_clean\", \"tax\", \"log_tax\",\n",
        "    \"mpg\", \"engine_per_mpg\", \"tax_per_mpg\"\n",
        "]\n",
        "\n",
        "numeric_maybe = [\"engine_missing\", \"age_x_engine\"]\n",
        "\n",
        "categorical_keep = [\n",
        "    \"model\", \"brand_model\", \"brand_model_year\", \"brand_model_fuel\",\n",
        "    \"brand_model_trans\", \"brand_model_engine\", \"brand_model_year_engine\"\n",
        "]\n",
        "\n",
        "categorical_maybe = [\"brand\", \"fuelType\", \"transmission\"]\n",
        "\n",
        "premium_features = [\n",
        "    \"is_premium_model\", \"is_luxury_suv\", \"is_performance_model\",\n",
        "    \"large_engine\", \"very_large_engine\", \"very_low_mileage\",\n",
        "    \"low_mileage\", \"new_low_mileage\", \"premium_large_engine\",\n",
        "    \"premium_low_mileage\", \"luxury_suv_large_engine\",\n",
        "    \"premium_new_low_mileage\"\n",
        "]\n",
        "\n",
        "final_features = numeric_keep + numeric_maybe + categorical_keep + categorical_maybe + premium_features\n",
        "final_features = [f for f in final_features if f in full_train.columns]\n",
        "\n",
        "final_cat_features = [\n",
        "    f for f in final_features\n",
        "    if full_train[f].dtype == \"object\" or str(full_train[f].dtype) == \"category\"\n",
        "]\n",
        "\n",
        "cat_idx = [final_features.index(c) for c in final_cat_features]\n",
        "\n",
        "print(\"Filtered train:\", full_train.shape)\n",
        "print(\"Features:\", len(final_features))\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 4. Validation split\n",
        "# -------------------------------\n",
        "\n",
        "train_part, val_part = train_test_split(\n",
        "    full_train,\n",
        "    test_size=0.30,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "X_tr = train_part[final_features].copy()\n",
        "y_tr = train_part[\"price\"].copy()\n",
        "y_tr_log = np.log1p(y_tr)\n",
        "\n",
        "X_val = val_part[final_features].copy()\n",
        "y_val = val_part[\"price\"].copy()\n",
        "\n",
        "X_tr_lgb = X_tr.copy()\n",
        "X_val_lgb = X_val.copy()\n",
        "\n",
        "for col in final_cat_features:\n",
        "    X_tr_lgb[col] = X_tr_lgb[col].astype(\"category\")\n",
        "    X_val_lgb[col] = X_val_lgb[col].astype(\"category\")\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 5. Train validation models\n",
        "# -------------------------------\n",
        "\n",
        "def rmse(y_true, y_pred):\n",
        "    return np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "\n",
        "print(\"Training validation LGBM log...\")\n",
        "lgb_log = LGBMRegressor(\n",
        "    n_estimators=2200,\n",
        "    learning_rate=0.018,\n",
        "    num_leaves=80,\n",
        "    max_depth=-1,\n",
        "    min_child_samples=25,\n",
        "    subsample=0.90,\n",
        "    colsample_bytree=0.90,\n",
        "    reg_alpha=0.05,\n",
        "    reg_lambda=0.5,\n",
        "    random_state=RANDOM_STATE,\n",
        "    n_jobs=-1,\n",
        "    verbose=-1\n",
        ")\n",
        "lgb_log.fit(X_tr_lgb, y_tr_log)\n",
        "val_lgb_log = np.expm1(lgb_log.predict(X_val_lgb))\n",
        "\n",
        "print(\"Training validation LGBM raw...\")\n",
        "lgb_raw = LGBMRegressor(\n",
        "    n_estimators=2200,\n",
        "    learning_rate=0.018,\n",
        "    num_leaves=80,\n",
        "    max_depth=-1,\n",
        "    min_child_samples=25,\n",
        "    subsample=0.90,\n",
        "    colsample_bytree=0.90,\n",
        "    reg_alpha=0.05,\n",
        "    reg_lambda=0.5,\n",
        "    random_state=RANDOM_STATE,\n",
        "    n_jobs=-1,\n",
        "    verbose=-1\n",
        ")\n",
        "lgb_raw.fit(X_tr_lgb, y_tr)\n",
        "val_lgb_raw = np.clip(lgb_raw.predict(X_val_lgb), 500, None)\n",
        "\n",
        "print(\"Training validation CatBoost log...\")\n",
        "cat_log = CatBoostRegressor(\n",
        "    iterations=1400,\n",
        "    learning_rate=0.035,\n",
        "    depth=7,\n",
        "    l2_leaf_reg=6,\n",
        "    loss_function=\"RMSE\",\n",
        "    random_seed=RANDOM_STATE,\n",
        "    verbose=0\n",
        ")\n",
        "cat_log.fit(Pool(X_tr, y_tr_log, cat_features=cat_idx))\n",
        "val_cat_log = np.expm1(cat_log.predict(X_val))\n",
        "\n",
        "print(\"Training validation CatBoost raw...\")\n",
        "cat_raw = CatBoostRegressor(\n",
        "    iterations=1400,\n",
        "    learning_rate=0.035,\n",
        "    depth=7,\n",
        "    l2_leaf_reg=6,\n",
        "    loss_function=\"RMSE\",\n",
        "    random_seed=RANDOM_STATE,\n",
        "    verbose=0\n",
        ")\n",
        "cat_raw.fit(Pool(X_tr, y_tr, cat_features=cat_idx))\n",
        "val_cat_raw = np.clip(cat_raw.predict(X_val), 500, None)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 6. Validation base ensemble\n",
        "# -------------------------------\n",
        "\n",
        "base_val_pred = (\n",
        "    0.434783 * val_lgb_log +\n",
        "    0.326087 * val_lgb_raw +\n",
        "    0.065217 * val_cat_log +\n",
        "    0.173913 * val_cat_raw\n",
        ")\n",
        "\n",
        "base_val_pred = base_val_pred.copy()\n",
        "base_val_pred[base_val_pred >= 39000] *= 1.009\n",
        "base_val_pred = np.clip(base_val_pred, 500, None)\n",
        "\n",
        "base_rmse = rmse(y_val, base_val_pred)\n",
        "print(\"Base validation RMSE:\", base_rmse)\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 7. Market-anchor function\n",
        "# -------------------------------\n",
        "\n",
        "def apply_market_anchor(train_ref, target_ref, base_pred, group_cols, max_gap, w_2_3, w_4_9, w_10_plus):\n",
        "    stats = (\n",
        "        train_ref\n",
        "        .groupby(group_cols, dropna=False)[\"price\"]\n",
        "        .agg([\"median\", \"count\"])\n",
        "        .reset_index()\n",
        "        .rename(columns={\"median\": \"market_median\", \"count\": \"market_count\"})\n",
        "    )\n",
        "\n",
        "    tmp = target_ref[group_cols].copy()\n",
        "    tmp[\"base_pred\"] = np.array(base_pred)\n",
        "\n",
        "    tmp = tmp.merge(stats, on=group_cols, how=\"left\")\n",
        "\n",
        "    tmp[\"relative_gap\"] = (\n",
        "        (tmp[\"market_median\"] - tmp[\"base_pred\"]).abs()\n",
        "        / tmp[\"base_pred\"]\n",
        "    )\n",
        "\n",
        "    pred = tmp[\"base_pred\"].copy()\n",
        "\n",
        "    valid = (\n",
        "        tmp[\"market_median\"].notna() &\n",
        "        (tmp[\"market_count\"] >= 2) &\n",
        "        (tmp[\"relative_gap\"] <= max_gap)\n",
        "    )\n",
        "\n",
        "    mask_2_3 = valid & (tmp[\"market_count\"] >= 2) & (tmp[\"market_count\"] < 4)\n",
        "    mask_4_9 = valid & (tmp[\"market_count\"] >= 4) & (tmp[\"market_count\"] < 10)\n",
        "    mask_10_plus = valid & (tmp[\"market_count\"] >= 10)\n",
        "\n",
        "    pred.loc[mask_2_3] = (\n",
        "        (1 - w_2_3) * pred.loc[mask_2_3] +\n",
        "        w_2_3 * tmp.loc[mask_2_3, \"market_median\"]\n",
        "    )\n",
        "\n",
        "    pred.loc[mask_4_9] = (\n",
        "        (1 - w_4_9) * pred.loc[mask_4_9] +\n",
        "        w_4_9 * tmp.loc[mask_4_9, \"market_median\"]\n",
        "    )\n",
        "\n",
        "    pred.loc[mask_10_plus] = (\n",
        "        (1 - w_10_plus) * pred.loc[mask_10_plus] +\n",
        "        w_10_plus * tmp.loc[mask_10_plus, \"market_median\"]\n",
        "    )\n",
        "\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    return pred, {\n",
        "        \"adjusted_rows\": int(valid.sum()),\n",
        "        \"rows_2_3\": int(mask_2_3.sum()),\n",
        "        \"rows_4_9\": int(mask_4_9.sum()),\n",
        "        \"rows_10_plus\": int(mask_10_plus.sum())\n",
        "    }\n",
        "\n",
        "\n",
        "# -------------------------------\n",
        "# 8. Market-anchor grid search\n",
        "# -------------------------------\n",
        "\n",
        "group_sets = {\n",
        "    \"near_full\": [\n",
        "        \"brand\", \"model\", \"year\", \"transmission\",\n",
        "        \"fuelType\", \"tax\", \"mpg\", \"engineSize\"\n",
        "    ],\n",
        "    \"brand_model_year_engine\": [\n",
        "        \"brand\", \"model\", \"year\", \"engineSize\"\n",
        "    ],\n",
        "    \"brand_model_year_trans\": [\n",
        "        \"brand\", \"model\", \"year\", \"transmission\"\n",
        "    ],\n",
        "    \"brand_model_year_fuel\": [\n",
        "        \"brand\", \"model\", \"year\", \"fuelType\"\n",
        "    ],\n",
        "    \"brand_model_year\": [\n",
        "        \"brand\", \"model\", \"year\"\n",
        "    ],\n",
        "    \"brand_model_engine\": [\n",
