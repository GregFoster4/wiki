      "source": [
        "# ===============================\n",
        "# HIGH-END ANCHOR VALIDATION CHECK + MICRO TUNE\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "def rmse(y_true, y_pred):\n",
        "    return np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "\n",
        "# -------------------------------\n",
        "# Rebuild best high-end correction\n",
        "# Best config from previous output:\n",
        "# brand_model_year, q70, min_count 8, max_gap 0.25, alpha 0.08\n",
        "# -------------------------------\n",
        "\n",
        "base_pred = np.array(best_anchored_pred).copy()\n",
        "actual = np.array(y_val)\n",
        "\n",
        "target_ref = val_part.copy().reset_index(drop=True)\n",
        "train_ref = train_part.copy().reset_index(drop=True)\n",
        "\n",
        "premium_models = [\n",
        "    \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "    \"gle class\", \"glc class\", \"v class\",\n",
        "    \"cls class\", \"sl class\", \"touareg\",\n",
        "    \"5 series\", \"e class\", \"a6\", \"a7\", \"a8\",\n",
        "    \"c class\", \"glc class\"\n",
        "]\n",
        "\n",
        "premium_mask = target_ref[\"model\"].isin(premium_models).values\n",
        "\n",
        "high_candidate_mask = (\n",
        "    premium_mask &\n",
        "    (\n",
        "        (base_pred >= 30000) |\n",
        "        ((target_ref[\"engineSize\"].values >= 3.0) & (target_ref[\"mileage\"].values <= 15000)) |\n",
        "        ((target_ref[\"year\"].values >= 2019) & (target_ref[\"mileage\"].values <= 5000))\n",
        "    )\n",
        ")\n",
        "\n",
        "group_cols = [\"brand\", \"model\", \"year\"]\n",
        "\n",
        "stats = (\n",
        "    train_ref\n",
        "    .groupby(group_cols, dropna=False)[\"price\"]\n",
        "    .agg(\n",
        "        market_count=\"count\",\n",
        "        market_median=\"median\",\n",
        "        q65=lambda x: x.quantile(0.65),\n",
        "        q70=lambda x: x.quantile(0.70),\n",
        "        q75=lambda x: x.quantile(0.75)\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "tmp = target_ref[group_cols].copy()\n",
        "tmp = tmp.merge(stats, on=group_cols, how=\"left\")\n",
        "\n",
        "anchor = tmp[\"q70\"]\n",
        "count = tmp[\"market_count\"]\n",
        "rel_gap = (anchor - base_pred).abs() / base_pred\n",
        "\n",
        "base_mask = (\n",
        "    high_candidate_mask &\n",
        "    anchor.notna().values &\n",
        "    (count.values >= 8) &\n",
        "    (rel_gap.values <= 0.25) &\n",
        "    (base_pred < anchor.values)\n",
        ")\n",
        "\n",
        "print(\"Rows adjusted by rule:\", base_mask.sum())\n",
        "print(\"Baseline RMSE:\", rmse(actual, base_pred))\n",
        "\n",
        "# -------------------------------\n",
        "# Micro tune alpha around 0.08\n",
        "# -------------------------------\n",
        "\n",
        "alpha_results = []\n",
        "\n",
        "for alpha in np.arange(0.03, 0.121, 0.005):\n",
        "    pred = base_pred.copy()\n",
        "    pred[base_mask] = (1 - alpha) * pred[base_mask] + alpha * anchor.values[base_mask]\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    alpha_results.append({\n",
        "        \"alpha\": round(alpha, 3),\n",
        "        \"rmse\": rmse(actual, pred),\n",
        "        \"improvement\": rmse(actual, base_pred) - rmse(actual, pred),\n",
        "        \"mean_adjustment\": float((pred[base_mask] - base_pred[base_mask]).mean())\n",
        "    })\n",
        "\n",
        "alpha_results_df = pd.DataFrame(alpha_results).sort_values(\"rmse\").reset_index(drop=True)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"ALPHA MICRO TUNE\")\n",
        "print(\"==============================\")\n",
        "display(alpha_results_df.head(20))\n",
        "\n",
        "best_alpha = float(alpha_results_df.iloc[0][\"alpha\"])\n",
        "\n",
        "best_pred = base_pred.copy()\n",
        "best_pred[base_mask] = (1 - best_alpha) * best_pred[base_mask] + best_alpha * anchor.values[base_mask]\n",
        "best_pred = np.clip(best_pred, 500, None)\n",
        "\n",
        "# -------------------------------\n",
        "# Check by actual price band\n",
        "# -------------------------------\n",
        "\n",
        "check = target_ref.copy()\n",
        "check[\"actual\"] = actual\n",
        "check[\"before\"] = base_pred\n",
        "check[\"after\"] = best_pred\n",
        "check[\"err_before\"] = check[\"before\"] - check[\"actual\"]\n",
        "check[\"err_after\"] = check[\"after\"] - check[\"actual\"]\n",
        "check[\"changed\"] = base_mask\n",
        "\n",
        "check[\"actual_band\"] = pd.cut(\n",
        "    check[\"actual\"],\n",
        "    bins=[0, 10000, 20000, 30000, 40000, 60000, 120000],\n",
        "    labels=[\"0-10k\", \"10-20k\", \"20-30k\", \"30-40k\", \"40-60k\", \"60k+\"]\n",
        ")\n",
        "\n",
        "band_check = (\n",
        "    check\n",
        "    .groupby(\"actual_band\")\n",
        "    .apply(lambda x: pd.Series({\n",
        "        \"count\": len(x),\n",
        "        \"changed_rows\": int(x[\"changed\"].sum()),\n",
        "        \"rmse_before\": rmse(x[\"actual\"], x[\"before\"]),\n",
        "        \"rmse_after\": rmse(x[\"actual\"], x[\"after\"]),\n",
        "        \"mean_error_before\": x[\"err_before\"].mean(),\n",
        "        \"mean_error_after\": x[\"err_after\"].mean()\n",
        "    }))\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"PRICE BAND CHECK\")\n",
        "print(\"==============================\")\n",
        "display(band_check)\n",
        "\n",
        "# -------------------------------\n",
        "# Check changed rows only\n",
        "# -------------------------------\n",
        "\n",
        "changed = check[check[\"changed\"]].copy()\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"CHANGED ROWS ONLY\")\n",
        "print(\"==============================\")\n",
        "print(\"Changed rows:\", len(changed))\n",
        "print(\"RMSE before:\", rmse(changed[\"actual\"], changed[\"before\"]))\n",
        "print(\"RMSE after:\", rmse(changed[\"actual\"], changed[\"after\"]))\n",
        "print(\"Mean error before:\", changed[\"err_before\"].mean())\n",
        "print(\"Mean error after:\", changed[\"err_after\"].mean())\n",
        "\n",
        "display(\n",
        "    changed[\n",
        "        [\"ID\", \"brand\", \"model\", \"year\", \"transmission\", \"fuelType\",\n",
        "         \"mileage\", \"engineSize\", \"actual\", \"before\", \"after\",\n",
        "         \"err_before\", \"err_after\"]\n",
        "    ]\n",
        "    .sort_values(\"actual\", ascending=False)\n",
        "    .head(40)\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"FINAL CHECK\")\n",
        "print(\"==============================\")\n",
        "print(\"Best alpha:\", best_alpha)\n",
        "print(\"Final RMSE:\", rmse(actual, best_pred))\n",
        "print(\"Improvement:\", rmse(actual, base_pred) - rmse(actual, best_pred))"
      ],
