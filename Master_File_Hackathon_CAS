      "source": [
        "# ===============================\n",
        "# HIGH-END ANCHOR REFINEMENT TEST\n",
        "# Goal: keep the +1.09 gain, reduce damage to 20-40k rows\n",
        "# ===============================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "def rmse(y_true, y_pred):\n",
        "    return np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "\n",
        "base_pred = np.array(best_anchored_pred).copy()\n",
        "actual = np.array(y_val)\n",
        "\n",
        "target_ref = val_part.copy().reset_index(drop=True)\n",
        "train_ref = train_part.copy().reset_index(drop=True)\n",
        "\n",
        "baseline_rmse = rmse(actual, base_pred)\n",
        "\n",
        "print(\"Baseline RMSE:\", baseline_rmse)\n",
        "\n",
        "premium_models = [\n",
        "    \"q7\", \"q5\", \"x5\", \"x3\", \"x2\",\n",
        "    \"gle class\", \"glc class\", \"v class\",\n",
        "    \"cls class\", \"sl class\", \"touareg\",\n",
        "    \"5 series\", \"e class\", \"a6\", \"a7\", \"a8\",\n",
        "    \"c class\"\n",
        "]\n",
        "\n",
        "premium_mask = target_ref[\"model\"].isin(premium_models).values\n",
        "\n",
        "group_cols = [\"brand\", \"model\", \"year\"]\n",
        "\n",
        "stats = (\n",
        "    train_ref\n",
        "    .groupby(group_cols, dropna=False)[\"price\"]\n",
        "    .agg(\n",
        "        market_count=\"count\",\n",
        "        market_median=\"median\",\n",
        "        q65=lambda x: x.quantile(0.65),\n",
        "        q70=lambda x: x.quantile(0.70),\n",
        "        q75=lambda x: x.quantile(0.75)\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "tmp = target_ref[group_cols].copy()\n",
        "tmp = tmp.merge(stats, on=group_cols, how=\"left\")\n",
        "\n",
        "rows = []\n",
        "\n",
        "for quantile in [\"q65\", \"q70\", \"q75\"]:\n",
        "    anchor = tmp[quantile].values\n",
        "    count = tmp[\"market_count\"].values\n",
        "\n",
        "    for alpha in np.arange(0.03, 0.101, 0.005):\n",
        "        for min_pred in [28000, 30000, 32000, 35000, 38000, 40000]:\n",
        "            for min_abs_lift in [0, 250, 500, 750, 1000, 1500]:\n",
        "                for max_gap in [0.15, 0.20, 0.25]:\n",
        "                    for min_count in [5, 8, 12]:\n",
        "\n",
        "                        high_candidate_mask = (\n",
        "                            premium_mask &\n",
        "                            (\n",
        "                                (base_pred >= min_pred) |\n",
        "                                ((target_ref[\"engineSize\"].values >= 3.0) & (target_ref[\"mileage\"].values <= 12000)) |\n",
        "                                ((target_ref[\"year\"].values >= 2019) & (target_ref[\"mileage\"].values <= 3000))\n",
        "                            )\n",
        "                        )\n",
        "\n",
        "                        rel_gap = np.abs(anchor - base_pred) / base_pred\n",
        "                        abs_lift = anchor - base_pred\n",
        "\n",
        "                        mask = (\n",
        "                            high_candidate_mask &\n",
        "                            ~pd.isna(anchor) &\n",
        "                            (count >= min_count) &\n",
        "                            (rel_gap <= max_gap) &\n",
        "                            (abs_lift >= min_abs_lift)\n",
        "                        )\n",
        "\n",
        "                        pred = base_pred.copy()\n",
        "                        pred[mask] = (1 - alpha) * pred[mask] + alpha * anchor[mask]\n",
        "                        pred = np.clip(pred, 500, None)\n",
        "\n",
        "                        score = rmse(actual, pred)\n",
        "\n",
        "                        rows.append({\n",
        "                            \"quantile\": quantile,\n",
        "                            \"alpha\": round(float(alpha), 3),\n",
        "                            \"min_pred\": min_pred,\n",
        "                            \"min_abs_lift\": min_abs_lift,\n",
        "                            \"max_gap\": max_gap,\n",
        "                            \"min_count\": min_count,\n",
        "                            \"adjusted_rows\": int(mask.sum()),\n",
        "                            \"rmse\": score,\n",
        "                            \"improvement\": baseline_rmse - score,\n",
        "                            \"mean_adjustment\": float((pred[mask] - base_pred[mask]).mean()) if mask.sum() else 0\n",
        "                        })\n",
        "\n",
        "refine_results = (\n",
        "    pd.DataFrame(rows)\n",
        "    .sort_values(\"rmse\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"TOP REFINED HIGH-END RULES\")\n",
        "print(\"==============================\")\n",
        "display(refine_results.head(30))\n",
        "\n",
        "best = refine_results.iloc[0].to_dict()\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"BEST REFINED RESULT\")\n",
        "print(\"==============================\")\n",
        "print(\"Baseline RMSE:\", baseline_rmse)\n",
        "print(\"Best RMSE:\", best[\"rmse\"])\n",
        "print(\"Improvement:\", best[\"improvement\"])\n",
        "print(\"Best config:\", best)\n",
        "\n",
        "# -------------------------------\n",
        "# Rebuild best prediction and band check\n",
        "# -------------------------------\n",
        "\n",
        "anchor = tmp[best[\"quantile\"]].values\n",
        "count = tmp[\"market_count\"].values\n",
        "rel_gap = np.abs(anchor - base_pred) / base_pred\n",
        "abs_lift = anchor - base_pred\n",
        "\n",
        "high_candidate_mask = (\n",
        "    premium_mask &\n",
        "    (\n",
        "        (base_pred >= best[\"min_pred\"]) |\n",
        "        ((target_ref[\"engineSize\"].values >= 3.0) & (target_ref[\"mileage\"].values <= 12000)) |\n",
        "        ((target_ref[\"year\"].values >= 2019) & (target_ref[\"mileage\"].values <= 3000))\n",
        "    )\n",
        ")\n",
        "\n",
        "best_mask = (\n",
        "    high_candidate_mask &\n",
        "    ~pd.isna(anchor) &\n",
        "    (count >= best[\"min_count\"]) &\n",
        "    (rel_gap <= best[\"max_gap\"]) &\n",
        "    (abs_lift >= best[\"min_abs_lift\"])\n",
        ")\n",
        "\n",
        "best_pred_refined = base_pred.copy()\n",
        "best_pred_refined[best_mask] = (\n",
        "    (1 - best[\"alpha\"]) * best_pred_refined[best_mask] +\n",
        "    best[\"alpha\"] * anchor[best_mask]\n",
        ")\n",
        "best_pred_refined = np.clip(best_pred_refined, 500, None)\n",
        "\n",
        "check = target_ref.copy()\n",
        "check[\"actual\"] = actual\n",
        "check[\"before\"] = base_pred\n",
        "check[\"after\"] = best_pred_refined\n",
        "check[\"changed\"] = best_mask\n",
        "check[\"err_before\"] = check[\"before\"] - check[\"actual\"]\n",
        "check[\"err_after\"] = check[\"after\"] - check[\"actual\"]\n",
        "\n",
        "check[\"actual_band\"] = pd.cut(\n",
        "    check[\"actual\"],\n",
        "    bins=[0, 10000, 20000, 30000, 40000, 60000, 120000],\n",
        "    labels=[\"0-10k\", \"10-20k\", \"20-30k\", \"30-40k\", \"40-60k\", \"60k+\"]\n",
        ")\n",
        "\n",
        "band_check_refined = (\n",
        "    check\n",
        "    .groupby(\"actual_band\")\n",
        "    .apply(lambda x: pd.Series({\n",
        "        \"count\": len(x),\n",
        "        \"changed_rows\": int(x[\"changed\"].sum()),\n",
        "        \"rmse_before\": rmse(x[\"actual\"], x[\"before\"]),\n",
        "        \"rmse_after\": rmse(x[\"actual\"], x[\"after\"]),\n",
        "        \"mean_error_before\": x[\"err_before\"].mean(),\n",
        "        \"mean_error_after\": x[\"err_after\"].mean()\n",
        "    }))\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"REFINED PRICE BAND CHECK\")\n",
        "print(\"==============================\")\n",
        "display(band_check_refined)\n",
        "\n",
        "changed = check[check[\"changed\"]].copy()\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"REFINED CHANGED ROWS ONLY\")\n",
        "print(\"==============================\")\n",
        "print(\"Changed rows:\", len(changed))\n",
        "print(\"RMSE before:\", rmse(changed[\"actual\"], changed[\"before\"]))\n",
        "print(\"RMSE after:\", rmse(changed[\"actual\"], changed[\"after\"]))\n",
        "print(\"Mean error before:\", changed[\"err_before\"].mean())\n",
        "print(\"Mean error after:\", changed[\"err_after\"].mean())\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"FINAL REFINED CHECK\")\n",
        "print(\"==============================\")\n",
        "print(\"Final RMSE:\", rmse(actual, best_pred_refined))\n",
        "print(\"Improvement:\", baseline_rmse - rmse(actual, best_pred_refined))"
