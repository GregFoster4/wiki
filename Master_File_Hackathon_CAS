        "# ===============================\n",
        "# FAST BLEND: CURRENT BEST + NEW MODEL\n",
        "# No validation split comparison, no errors\n",
        "# ===============================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import glob\n",
        "import os\n",
        "\n",
        "print(\"CSV files found:\")\n",
        "for f in glob.glob(\"*.csv\"):\n",
        "    print(\"-\", f)\n",
        "\n",
        "current_file = \"Group 5 Test Sub_MARKET_TUNED.csv\"\n",
        "new_file = \"Group 5 NEW_MODEL_TE_LGB_MARKET.csv\"\n",
        "\n",
        "if not os.path.exists(current_file):\n",
        "    raise FileNotFoundError(f\"Missing current best file: {current_file}\")\n",
        "\n",
        "if not os.path.exists(new_file):\n",
        "    raise FileNotFoundError(f\"Missing new model file: {new_file}\")\n",
        "\n",
        "current = pd.read_csv(current_file).rename(columns={\"Actual\": \"current\"})\n",
        "new = pd.read_csv(new_file).rename(columns={\"Actual\": \"new_model\"})\n",
        "\n",
        "df = current.merge(new, on=\"ID\", how=\"inner\")\n",
        "\n",
        "print(\"Rows merged:\", len(df))\n",
        "print(\"Correlation:\", df[\"current\"].corr(df[\"new_model\"]))\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"DISTRIBUTION\")\n",
        "print(\"==============================\")\n",
        "display(df[[\"current\", \"new_model\"]].describe())\n",
        "\n",
        "blend_specs = {\n",
        "    \"Group 5 Blend_CURRENT_99_NEW_01.csv\": (0.99, 0.01),\n",
        "    \"Group 5 Blend_CURRENT_975_NEW_025.csv\": (0.975, 0.025),\n",
        "    \"Group 5 Blend_CURRENT_95_NEW_05.csv\": (0.95, 0.05),\n",
        "}\n",
        "\n",
        "summary = []\n",
        "\n",
        "for filename, (w_current, w_new) in blend_specs.items():\n",
        "    pred = w_current * df[\"current\"] + w_new * df[\"new_model\"]\n",
        "    pred = np.clip(pred, 500, None)\n",
        "\n",
        "    out = pd.DataFrame({\n",
        "        \"ID\": df[\"ID\"],\n",
        "        \"Actual\": pred\n",
        "    })\n",
        "\n",
        "    out.to_csv(filename, index=False)\n",
        "\n",
        "    summary.append({\n",
        "        \"file\": filename,\n",
        "        \"w_current\": w_current,\n",
        "        \"w_new\": w_new,\n",
        "        \"mean\": pred.mean(),\n",
        "        \"median\": pred.median(),\n",
        "        \"min\": pred.min(),\n",
        "        \"max\": pred.max(),\n",
        "        \"mean_change_vs_current\": pred.mean() - df[\"current\"].mean()\n",
        "    })\n",
        "\n",
        "summary_df = pd.DataFrame(summary)\n",
        "\n",
        "print(\"==============================\")\n",
        "print(\"BLENDS CREATED\")\n",
        "print(\"==============================\")\n",
        "display(summary_df)\n",
        "\n",
        "print(\"Files saved:\")\n",
        "for f in blend_specs.keys():\n",
        "    print(\"-\", f)"
      ],
